{
  "name": "@karavaldon/timequake",
  "version": "2.0.0",
  "description": "Timequake v2 \u2014 Kara Valdon's black-and-white design system for a running PWA that pairs with a watch and a sensor strap.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run tokens && npm run audit:contrast && npm run typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "a11y": "node scripts/a11y.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "mapbox-gl": "^3.0.0"
  },
  "dependencies": {
    "@fontsource/chivo-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.19",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.1",
    "mapbox-gl": "^3.35.2",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/global.css",
    "./tokens.json": "./tokens/dist/tokens.json"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    }
  }
}
